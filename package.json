{
  "name": "@mohatt/website",
  "private": true,
  "description": "Codebase for my personal website",
  "version": "3.0.0",
  "sideEffects": [
    "src/**/*.css"
  ],
  "scripts": {
    "clean": "gatsby clean",
    "start": "gatsby develop -H 0.0.0.0",
    "build": "gatsby build",
    "build:profile": "gatsby build --profile",
    "serve": "gatsby serve -H 0.0.0.0",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint 'src/**/*.css'",
    "eslint:config": "eslint --print-config .eslintrc.json",
    "eslint:check": "eslint-config-prettier .eslintrc.json",
    "fonts:preload-cache": "gatsby-preload-fonts"
  },
  "keywords": [
    "website",
    "gatsby",
    "react",
    "tailwindcss"
  ],
  "author": "Mohamed Elkholy <mohatt@pm.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohatt/website.git"
  },
  "homepage": "https://github.com/mohatt/website",
  "bugs": "https://github.com/mohatt/website/issues",
  "dependencies": {
    "@mdx-js/react": "2.3.0",
    "autoprefixer": "10.4.21",
    "clsx": "2.1.1",
    "gatsby": "5.14.6",
    "gatsby-plugin-advanced-pages": "^5.1.1",
    "gatsby-plugin-image": "^3.14.0",
    "gatsby-plugin-manifest": "^5.14.0",
    "gatsby-plugin-mdx": "^5.14.1",
    "gatsby-plugin-postbuild": "^3.0.2",
    "gatsby-plugin-postcss": "^6.14.0",
    "gatsby-plugin-preload-fonts": "^4.14.0",
    "gatsby-plugin-react-helmet-async": "^1.2.3",
    "gatsby-plugin-sharp": "^5.14.0",
    "gatsby-plugin-sitemap": "^6.14.0",
    "gatsby-remark-smartypants": "^6.14.0",
    "gatsby-source-filesystem": "^5.14.0",
    "gatsby-transformer-sharp": "^5.14.0",
    "gatsby-transformer-yaml": "^5.14.0",
    "graphql": "^16.8.1",
    "lodash": "^4.17.21",
    "photoswipe": "^5.4.4",
    "postcss": "^8.4.24",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^10.2.4",
    "postcss-reporter": "^7.1.0",
    "postcss-url": "^10.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^1.3.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@mohatt/eslint-config-gatsby-standard": "^4.0.0",
    "eslint": "^7.32.0",
    "prettier": "^3.6.2",
    "simple-icons": "^6.23.0",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5.9.2",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not IE 11",
    "not op_mini all",
    "not dead"
  ],
  "renovate": {
    "extends": [
      "config:js-app"
    ]
  }
}
