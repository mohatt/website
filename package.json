{
  "name": "@mohatt/website",
  "version": "3.0.0",
  "private": true,
  "description": "Codebase for my personal website",
  "keywords": [
    "website",
    "gatsby",
    "react",
    "tailwindcss"
  ],
  "homepage": "https://github.com/mohatt/website",
  "bugs": "https://github.com/mohatt/website/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohatt/website.git"
  },
  "license": "MIT",
  "author": "Mohamed Elkholy <mohatt@pm.me>",
  "sideEffects": [
    "src/**/*.css"
  ],
  "scripts": {
    "build": "gatsby build",
    "build:profile": "gatsby build --profile",
    "clean": "gatsby clean",
    "eslint:check": "eslint-config-prettier .eslintrc.json",
    "eslint:config": "eslint --print-config .eslintrc.json",
    "fonts:preload-cache": "gatsby-preload-fonts",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:js": "eslint .",
    "serve": "gatsby serve -H 0.0.0.0",
    "start": "gatsby develop -H 0.0.0.0",
    "typecheck": "tsc --noEmit -p ."
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not IE 11",
    "not op_mini all",
    "not dead"
  ],
  "dependencies": {
    "@mdx-js/react": "^2.3.0",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "firebase": "^12.2.1",
    "gatsby": "^5.15.0",
    "gatsby-plugin-advanced-pages": "^5.2.0",
    "gatsby-plugin-image": "^3.15.0",
    "gatsby-plugin-manifest": "^5.15.0",
    "gatsby-plugin-mdx": "^5.15.0",
    "gatsby-plugin-postbuild": "^4.0.1",
    "gatsby-plugin-postcss": "^6.15.0",
    "gatsby-plugin-preload-fonts": "^4.15.0",
    "gatsby-plugin-react-helmet-async": "^1.2.3",
    "gatsby-plugin-sharp": "^5.15.0",
    "gatsby-plugin-sitemap": "^6.15.0",
    "gatsby-remark-smartypants": "^6.15.0",
    "gatsby-source-filesystem": "^5.15.0",
    "gatsby-transformer-sharp": "^5.15.0",
    "gatsby-transformer-yaml": "^5.15.0",
    "graphql": "^16.7.1",
    "lodash": "^4.17.21",
    "overlayscrollbars": "^2.12.0",
    "overlayscrollbars-react": "^0.5.6",
    "photoswipe": "^5.4.4",
    "postcss": "^8.4.24",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^10.3.1",
    "postcss-reporter": "^7.1.0",
    "postcss-url": "^10.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-firebase-hooks": "^5.1.1",
    "react-helmet-async": "^1.3.0",
    "react-masonry-css": "^1.0.16",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@mohatt/eslint-config-gatsby-standard": "^4.1.2",
    "@types/gtag.js": "^0.0.20",
    "@types/lodash": "^4.17.20",
    "@types/node": "^18.19.124",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "eslint": "^7.32.0",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^2.5.19",
    "simple-icons": "^15.15.0",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-config-tailwindcss": "^1.0.0",
    "typescript": "^5.1.6",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "renovate": {
    "extends": [
      "config:js-app"
    ]
  }
}
